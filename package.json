{
  "name": "svg-api",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance, zero-cold-start dynamic SVG badge, micro-button, icon, tech stack, and quote card engine for svg.xul.is.",
  "author": { "name": "XulbuX", "email": "hi@xul.is" },
  "maintainers": ["XulbuX <hi@xul.is>"],
  "repository": { "type": "git", "url": "https://github.com/xulbux/svg-api" },
  "bugs": { "url": "https://github.com/xulbux/svg-api/issues" },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm run fmt:check && pnpm run lint:check && pnpm run lint:md && pnpm run type-check && pnpm run test && pnpm exec wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint:md": "pnpm dlx markdownlint-cli2@0.23.3 \"**/*.md\" \"#node_modules\" \"#.wrangler\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@iconify-json/devicon-plain": "^1.2.62",
    "@iconify-json/simple-icons": "^1.2.100",
    "hono": "^4.13.13",
    "lucide-static": "^1.57.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
