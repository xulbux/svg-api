{
  "name": "svg-api",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance, zero-cold-start dynamic SVG engine on Cloudflare Workers.",
  "homepage": "https://svg.xul.is",
  "author": { "name": "XulbuX", "email": "hi@xul.is" },
  "repository": { "type": "git", "url": "https://github.com/xulbux/svg-api" },
  "bugs": { "url": "https://github.com/xulbux/svg-api/issues" },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/buildClient.ts",
    "check": "pnpm run build:client && pnpm run fmt:check && pnpm run lint:check && pnpm run lint:md && pnpm run type-check && vitest run && wrangler deploy --dry-run",
    "deploy": "pnpm run build:client && wrangler deploy",
    "dev": "pnpm run build:client && wrangler dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix --deny-warnings",
    "lint:check": "oxlint --deny-warnings",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.wrangler\" \"#dist\"",
    "test": "pnpm run build:client && vitest run",
    "test:watch": "pnpm run build:client && vitest",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json"
  },
  "engines": { "node": ">=26" },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@iconify-json/devicon-plain": "^1.2.62",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "hono": "^4.13.13",
    "lucide-static": "^1.57.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
