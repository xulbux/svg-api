{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf", "**/*.png"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.css", "**/*.client.js", "**/*.iconpack"], "fallthrough": true }
  ],
  "routes": [
    { "pattern": "svg.xul.is", "custom_domain": true }
  ]
}
