{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "upload_source_maps": true,
  "workers_dev": false,
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": ["**/*.css", "**/*.client.js"],
      "fallthrough": true
    }
  ],
  "routes": [
    {
      "pattern": "svg.xul.is",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEFAULT_GH_OWNER": "xulbux",
    "ALLOW_PREVIEW_IN_PROD": "true"
  }
}
